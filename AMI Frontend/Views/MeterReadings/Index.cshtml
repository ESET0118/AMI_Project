@{
    ViewBag.Title = "Meter Readings & Billing";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string serialNo = ViewBag.SerialNo ?? "";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <h4 class="fw-bold text-primary"><i class="bi bi-bar-chart-line"></i> Meter Readings & Billing</h4>
        <a class="btn btn-outline-secondary btn-sm" href="javascript:history.back()"><i class="bi bi-arrow-left"></i> Back</a>
    </div>

    <!-- Picker -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body d-flex flex-wrap gap-3 align-items-end">
            <div style="flex:1 1 200px;">
                <label class="fw-semibold">Meter Serial:</label>
                <input type="text" class="form-control" id="meterSerial" value="@serialNo" readonly />
            </div>

            <div style="flex:1 1 120px;">
                <label class="fw-semibold">Year:</label>
                <input type="number" id="year" class="form-control" />
            </div>

            <div style="flex:1 1 120px;">
                <label class="fw-semibold">Month:</label>
                <select id="month" class="form-select">
                    @for (int i = 1; i <= 12; i++)
                    {
                        <option value="@i">@i</option>
                    }
                </select>
            </div>

            <div class="d-flex gap-2">
                <button id="bulkSaveBtn" class="btn btn-save"><i class="bi bi-save"></i> Save All</button>
                <button id="generateBillBtn" class="btn btn-gradient"><i class="bi bi-receipt"></i> Generate Bill</button>
            </div>
        </div>
    </div>

    <div id="monthNameDisplay" class="mb-3"><h3></h3></div>

    <!-- Calendar -->
    <div id="calendarContainer" class="card d-none shadow-sm">
        <div class="card-body">
            <div id="monthlySummary" class="mb-3"></div>

            <div class="table-responsive">
                <table class="table table-bordered table-hover table-sm align-middle text-center">
                    <thead class="table-light">
                        <tr>
                            <th>Day</th>
                            <th>Consumption (kWh)</th>
                            <th>Voltage</th>
                            <th>Ampere</th>
                            <th>Power Factor</th>
                            <th>Frequency</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="calendarBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Billing Modal -->
<div class="modal fade" id="billModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h4>Esyahard Electricals</h4>
                <small>Official Electricity Bill</small>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <table class="table table-borderless mb-3">
                    <tbody>
                        <tr>
                            <th>Meter Serial:</th>
                            <td id="modalMeterSerial"></td>
                            <th>Month/Year:</th>
                            <td id="modalMonthYear"></td>
                        </tr>
                        <tr>
                            <th>Total Units:</th>
                            <td id="modalTotalUnits"></td>
                            <th>Base Rate:</th>
                            <td>₹<span id="modalBaseRate"></span></td>
                        </tr>
                        <tr>
                            <th>Tax Rate:</th>
                            <td id="modalTaxRate"></td>
                            <th>Total Bill:</th>
                            <td>₹<span id="modalBillAmount"></span></td>
                        </tr>
                    </tbody>
                </table>

                <h6 class="fw-bold">Slabs Applied:</h6>
                <table class="table table-sm table-striped table-bordered mb-3">
                    <thead class="table-light">
                        <tr><th>#</th><th>Details</th></tr>
                    </thead>
                    <tbody id="modalSlabsTable"></tbody>
                </table>

                <div class="text-center mb-3">
                    <img id="modalQrCode" alt="QR Code" style="width:140px; height:140px;" />
                    <p class="small text-muted mt-1">Scan to view or pay online</p>
                </div>

                <div class="text-center">
                    <button id="payBillBtn" class="btn btn-pay btn-lg"><i class="bi bi-cash-stack"></i> Pay Bill</button>
                </div>
            </div>

            <div class="modal-footer justify-content-center">
                <small class="text-muted">Thank you for choosing Esyahard Electricals!</small>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    const apiMeterReadingsBase = "https://localhost:7199/api/meterreading";
    const apiBillBase = "https://localhost:7199/api/Billing";

    $(function() {
        const meterSerialNo = $("#meterSerial").val();
        if(!meterSerialNo) { alert("No meter selected!"); return; }

        const now = new Date();
        $("#year").val(now.getUTCFullYear());
        $("#month").val(now.getUTCMonth() + 1);

        updateMonthName();
        loadCalendar();

        $("#month, #year").change(() => { updateMonthName(); loadCalendar(); });
        $("#bulkSaveBtn").click(bulkSave);
        $("#generateBillBtn").click(generateBill);
        $("#payBillBtn").click(() => alert("Thank you! Your bill has been paid."));
    });

    function updateMonthName() {
        const monthIndex = parseInt($("#month").val()) - 1;
        const monthName = new Date(0, monthIndex).toLocaleString('en-US', { month: 'long' });
        $("#monthNameDisplay h3").text(monthName);
    }

    function loadCalendar() {
        const meterSerialNo = $("#meterSerial").val();
        const year = parseInt($("#year").val());
        const month = parseInt($("#month").val());

        $("#calendarContainer").addClass("d-none");
        $("#calendarBody").html("<tr><td colspan='7'>Loading...</td></tr>");

        $.get(`${apiMeterReadingsBase}/meter/${encodeURIComponent(meterSerialNo)}/calendar?year=${year}&month=${month}`)
            .done(data => {
                $("#calendarContainer").removeClass("d-none");
                $("#monthlySummary").text(`Monthly total: ${data.monthlyTotalKwh ?? 0} kWh — Monthly record exists: ${data.hasMonthlyRecord}`);
                renderCalendar(data.days);
            })
            .fail(() => {
                $("#calendarBody").html("<tr><td colspan='7' class='text-danger'>Error loading calendar.</td></tr>");
            });
    }

    function renderCalendar(days) {
        if(!days || days.length === 0) {
            $("#calendarBody").html("<tr><td colspan='7'>No readings found.</td></tr>");
            return;
        }

        const rows = days.map(d => {
            const dt = new Date(d.date);
            const dayNo = dt.getUTCDate();
            const weekDay = dt.toLocaleString('en-US', { weekday: 'short', timeZone: 'UTC' });
            return `<tr data-date="${d.date}">
                <td>${dayNo} <small>${weekDay}</small></td>
                <td><input class="form-control form-control-sm consumption" value="${d.consumptionKwh ?? ""}" /></td>
                <td><input class="form-control form-control-sm voltage" value="${d.voltage ?? ""}" /></td>
                <td><input class="form-control form-control-sm ampere" value="${d.ampere ?? ""}" /></td>
                <td><input class="form-control form-control-sm pf" value="${d.powerFactor ?? ""}" /></td>
                <td><input class="form-control form-control-sm freq" value="${d.frequency ?? ""}" /></td>
                <td><button class="btn btn-save btn-sm save-day"><i class="bi bi-save"></i> Save</button></td>
            </tr>`;
        }).join("");

        $("#calendarBody").html(rows);
        $(".save-day").off("click").on("click", function(){ saveSingleDay($(this).closest("tr")); });
    }

    function collectRowsData($tr = null) {
        const meterSerialNo = $("#meterSerial").val();
        const year = parseInt($("#year").val());
        const month = parseInt($("#month").val());
        const readings = [];
        const $rows = $tr ? $tr : $("#calendarBody tr");
        $rows.each(function(){
            const date = $(this).data("date");
            const consumption = parseFloatOrNull($(this).find(".consumption").val());
            if(isNaN(consumption)) return;
            readings.push({
                date,
                consumptionKwh: consumption,
                voltage: parseFloatOrNull($(this).find(".voltage").val()),
                ampere: parseFloatOrNull($(this).find(".ampere").val()),
                powerFactor: parseFloatOrNull($(this).find(".pf").val()),
                frequency: parseFloatOrNull($(this).find(".freq").val())
            });
        });
        return { meterSerialNo, year, month, readings };
    }

    function saveSingleDay($tr){
        const payload = collectRowsData($tr);
        const $btn = $tr.find(".save-day");
        $btn.prop("disabled", true).text("Saving...");
        $.ajax({
            url: `${apiMeterReadingsBase}/meter/${encodeURIComponent(payload.meterSerialNo)}/bulk?year=${payload.year}&month=${payload.month}`,
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(payload),
            success: () => loadCalendar(),
            error: xhr => alert("Error saving: " + (xhr.responseJSON?.message || xhr.responseText || xhr.statusText)),
            complete: () => $btn.prop("disabled", false).html('<i class="bi bi-save"></i> Save')
        });
    }

    function bulkSave() {
        const payload = collectRowsData();
        if(payload.readings.length === 0) return alert("No readings to save.");
        $("#bulkSaveBtn").prop("disabled", true).text("Saving...");
        $.ajax({
            url: `${apiMeterReadingsBase}/meter/${encodeURIComponent(payload.meterSerialNo)}/bulk?year=${payload.year}&month=${payload.month}`,
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(payload),
            success: () => { alert("Saved successfully."); loadCalendar(); },
            error: xhr => alert("Error saving: " + (xhr.responseJSON?.message || xhr.responseText || xhr.statusText)),
            complete: () => $("#bulkSaveBtn").prop("disabled", false).html('<i class="bi bi-save"></i> Save All')
        });
    }

    function generateBill() {
        const meterSerialNo = $("#meterSerial").val();
        const year = $("#year").val();
        const month = $("#month").val();

        if(!meterSerialNo) { alert("Meter serial is required"); return; }

        $.get(`${apiBillBase}/${encodeURIComponent(meterSerialNo)}?year=${year}&month=${month}`)
            .done(function(data) {
                $("#modalMeterSerial").text(data.meterSerialNo);
                $("#modalMonthYear").text(`${month}/${year}`);
                $("#modalBillAmount").text(data.billAmount.toFixed(2));
                $("#modalTotalUnits").text(data.totalUnits.toFixed(2));
                $("#modalBaseRate").text(data.baseRate.toFixed(2));
                $("#modalTaxRate").text(data.taxRate + "%");

                const slabs = (data.slabsApplied || "").split(',').map((s,i)=>`<tr><td>${i+1}</td><td>${s.trim()}</td></tr>`).join('');
                $("#modalSlabsTable").html(slabs || "<tr><td colspan='2'>-</td></tr>");

                $("#modalQrCode").attr("src", data.qrCodeUrl);
                new bootstrap.Modal(document.getElementById('billModal')).show();
            })
            .fail(function(xhr) {
                alert("Error fetching bill: " + (xhr.responseJSON?.message || xhr.responseText || xhr.statusText));
            });
    }

    function parseFloatOrNull(v){ const n = parseFloat(v); return isNaN(n) ? null : n; }
</script>

<style>
    .btn-gradient {
        background: linear-gradient(135deg, #6a11cb, #2575fc);
        color: #fff;
        border: none;
        font-weight: 600;
    }

    .btn-save {
        background: linear-gradient(135deg, #28a745, #1e7e34);
        color: #fff;
        border: none;
        font-weight: 600;
    }

    .btn-pay {
        background: linear-gradient(135deg, #ff416c, #ff4b2b);
        color: #fff;
        font-weight: 700;
    }
</style>
