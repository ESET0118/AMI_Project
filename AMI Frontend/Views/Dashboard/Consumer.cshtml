@{
    ViewBag.Title = "Consumer Dashboard";
    ViewBag.HideSidebar = true;   // <—— ADD THIS

    Layout = "~/Views/Shared/_NavUser.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">

<style>

    /* --------------------------------------------------
       GLOBAL
    -------------------------------------------------- */
    body {
        font-family: 'Roboto', sans-serif;
        background: #f4f6f9;
        color: #333;
        padding: 20px;
    }

    /* --------------------------------------------------
       TITLES & HEADERS
    -------------------------------------------------- */
    #welcomeText {
        font-size: 1.8rem;
        font-weight: 700;
        margin-bottom: 25px;
        color: #224abe;
    }

    h4.fw-bold {
        color: #333;
    }

    /* --------------------------------------------------
       BUTTONS
    -------------------------------------------------- */
    .btn-primary {
        background: linear-gradient(135deg, #4e73df, #224abe);
        border: none;
        font-weight: 600;
        color: white;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #224abe, #4e73df);
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
        }

    .btn-success {
        background: linear-gradient(135deg, #1cc88a, #198754);
        border: none;
        font-weight: 600;
        color: white;
    }

    .btn-pay,
    #payBtn {
        background: linear-gradient(135deg, #ff416c, #ff4b2b);
        border: none;
        color: white;
        font-weight: 700;
    }

        .btn-pay:hover,
        #payBtn:hover {
            transform: translateY(-2px);
            box-shadow: 0px 5px 12px rgba(255, 65, 108, 0.4);
        }

    /* --------------------------------------------------
       CARDS
    -------------------------------------------------- */
    .card {
        border-radius: 1rem;
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.07);
        background: #fff;
        padding: 20px;
    }

    /* --------------------------------------------------
       TABLES
    -------------------------------------------------- */
    table {
        border-radius: 10px;
        overflow: hidden;
        width: 100%;
    }

    thead {
        background: linear-gradient(135deg, #4e73df, #224abe);
        color: white;
    }

    tbody tr:hover {
        background: rgba(78, 115, 223, 0.1);
    }

    #readingTable thead {
        background: linear-gradient(135deg, #4e73df, #1cc88a);
    }

    #meterTable td,
    #readingTable td {
        padding: 0.65rem 0.75rem !important;
    }

    /* --------------------------------------------------
       MODALS
    -------------------------------------------------- */
    .modal-header {
        border-bottom: none;
    }

    #readingModal .modal-header {
        background: linear-gradient(135deg, #4e73df, #224abe);
        color: white;
    }

    #paymentModal .modal-header {
        background: linear-gradient(135deg, #198754, #28a745);
        color: white;
    }

    #paymentModal .modal-body {
        background: #f8f9fa;
        border-radius: 10px;
    }

    /* Billing Summary */
    .billing-summary th {
        width: 35%;
        background: #f5f5f5;
        font-weight: 600;
    }

    /* QR Code */
    .qr-code img {
        border-radius: 10px;
        border: 1px solid #ddd;
        padding: 5px;
    }

    /* --------------------------------------------------
       FOOTER
    -------------------------------------------------- */
    footer {
        text-align: center;
        padding: 1rem 0;
        color: #777;
        margin-top: 40px;
    }

</style>

<div class="container-fluid py-3">

    <!-- Greeting -->
    <h3 class="fw-bold mb-4" id="welcomeText"></h3>

    <!-- Meters Section -->
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">
        <h4 class="fw-bold text-dark"><i class="bi bi-speedometer2 text-primary"></i> My Meters</h4>
        <button id="refreshMeters" class="btn btn-success btn-sm">
            <i class="bi bi-arrow-clockwise"></i> Refresh
        </button>
    </div>

    <div class="card mb-4">
        <div class="card-body table-responsive">
            <table class="table table-striped text-center" id="meterTable">
                <thead>
                    <tr>
                        <th>Serial No</th>
                        <th>IP Address</th>
                        <th>Manufacturer</th>
                        <th>Status</th>
                        <th>Installed</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="meterTableBody">
                    <tr><td colspan="6" class="text-muted py-4">Loading meters...</td></tr>
                </tbody>
            </table>
        </div>
    </div>

</div> <!-- END Container -->
<!-- =======================================================================================
     READING MODAL — (1st Modal)
======================================================================================= -->
<div class="modal fade" id="readingModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="readingModalTitle"></h5>
                <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <!-- Filter Controls -->
                <div class="d-flex gap-2 mb-3 flex-wrap align-items-end">
                    <div class="flex-grow-1">
                        <label class="form-label small">Year</label>
                        <input type="number" id="year" class="form-control form-control-sm" />
                    </div>

                    <div class="flex-grow-1">
                        <label class="form-label small">Month</label>
                        <select id="month" class="form-select form-select-sm">
                            @for (int i = 1; i <= 12; i++)
                            {
                                <option value="@i">@i</option>
                            }
                        </select>
                    </div>

                    <button id="generateBillBtn" class="btn btn-primary ms-auto btn-sm">
                        <i class="bi bi-cash-stack"></i> Generate Bill
                    </button>
                </div>

                <!-- Readings Table -->
                <div class="card shadow-lg border-0 rounded-4 my-2">
                    <div class="card-body p-0 table-responsive" style="max-height: 400px; overflow-y:auto;">
                        <table class="table table-sm table-hover text-center mb-0" id="readingTable">
                            <thead class="text-white"
                                   style="background: linear-gradient(135deg,#4e73df,#1cc88a); text-shadow: 0 1px 2px rgba(0,0,0,0.3);">
                                <tr>
                                    <th>Day</th>
                                    <th>Consumption (kWh)</th>
                                    <th>Voltage</th>
                                    <th>Ampere</th>
                                    <th>Power Factor</th>
                                    <th>Frequency</th>
                                </tr>
                            </thead>
                            <tbody id="readingBody"></tbody>
                        </table>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div> <!-- END READING MODAL -->
<!-- =======================================================================================
     PAYMENT MODAL — (Completely Separate Modal)
======================================================================================= -->
<div class="modal fade" id="paymentModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Bill Payment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <h5 class="text-center mb-3 text-primary">Electricity Bill Summary</h5>

                <table class="table table-bordered billing-summary">
                    <tbody>
                        <tr><th>Meter</th> <td id="modalMeter"></td></tr>
                        <tr><th>Total Units</th> <td id="modalUnits"></td></tr>
                        <tr><th>Base Rate (₹)</th> <td id="modalBaseRate"></td></tr>
                        <tr><th>Tax (%)</th> <td id="modalTaxRate"></td></tr>
                        <tr><th>Total Amount (₹)</th> <td id="modalAmount" class="fw-bold text-success"></td></tr>
                        <tr><th>Slabs Applied</th> <td id="modalSlabs"></td></tr>
                    </tbody>
                </table>

                <div class="qr-code">
                    <img id="billQR"
                         src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=PAYMENT"
                         alt="QR Code" />
                    <p class="small text-muted mt-2">Scan to Pay</p>
                </div>

            </div>

            <div class="modal-footer">
                <button id="payBtn" type="button" class="btn btn-success">Pay Now</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div> <!-- END PAYMENT MODAL -->



<footer>
    &copy; 2025 Ghosh Electricals. All Rights Reserved.
</footer>



<!-- JS Libraries -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


<script>

    /* ============================================================================================
       MAIN JS LOGIC — (unchanged except modal separation)
    ============================================================================================ */

    $(document).ready(function () {

        const consumerData = JSON.parse(localStorage.getItem("consumerData") || "null");

        if (!consumerData) {
            alert("No consumer data found! Redirecting to login.");
            window.location.href = "/Account/ConsumerLogin";
            return;
        }

        const consumerName = consumerData.consumerName || consumerData.name;
        const consumerId = consumerData.consumerId;

        $("#welcomeText").text(`Welcome, ${consumerName}`);

        const apiMeters = "https://localhost:7199/api/meters";
        const apiReadings = "https://localhost:7199/api/meterreading";
        const apiBilling = "https://localhost:7199/api/billing";



        /* ---------------- Load Meters ---------------- */
        function loadMeters() {
            $.get(`${apiMeters}/consumer/${encodeURIComponent(consumerName)}`)
                .done(data => {

                    if (!data || !data.length) {
                        $("#meterTableBody").html("<tr><td colspan='6'>No meters found.</td></tr>");
                        return;
                    }

                    $("#meterTableBody").html(
                        data.map(m => `
                        <tr>
                            <td>${m.meterSerialNo}</td>
                            <td>${m.ipAddress ?? '-'}</td>
                            <td>${m.manufacturer ?? '-'}</td>
                            <td>${m.status}</td>
                            <td>${m.installTsUtc ? new Date(m.installTsUtc).toLocaleDateString() : '-'}</td>
                            <td>
                                <button class="btn btn-primary btn-sm"
                                        onclick="openReadings('${m.meterSerialNo}')">
                                    View Readings
                                </button>
                            </td>
                        </tr>
                    `).join("")
                    );

                })
                .fail(() => {
                    $("#meterTableBody").html("<tr><td colspan='6'>Failed to load meters.</td></tr>");
                });
        }

        loadMeters();
        $("#refreshMeters").click(loadMeters);



        /* ---------------- Open Reading Modal ---------------- */
        window.openReadings = function (serial) {

            $("#readingModalTitle").text(`Meter Readings — ${serial}`);
            $("#readingModal").data("serialNo", serial);

            const now = new Date();
            $("#year").val(now.getFullYear());
            $("#month").val(now.getMonth() + 1);

            loadReadings(serial);

            new bootstrap.Modal(document.getElementById("readingModal")).show();
        };


        function loadReadings(serial) {

            const y = $("#year").val();
            const m = $("#month").val();

            $("#readingBody").html("<tr><td colspan='6'>Loading...</td></tr>");

            $.get(`${apiReadings}/meter/${serial}/calendar?year=${y}&month=${m}`)
                .done(data => {

                    if (!data.days || !data.days.length) {
                        $("#readingBody").html("<tr><td colspan='6'>No readings found.</td></tr>");
                        return;
                    }

                    $("#readingBody").html(
                        data.days.map(d => `
                        <tr>
                            <td>${new Date(d.date).getDate()}</td>
                            <td>${d.consumptionKwh ?? 0}</td>
                            <td>${d.voltage ?? 0}</td>
                            <td>${d.ampere ?? 0}</td>
                            <td>${d.powerFactor ?? 0}</td>
                            <td>${d.frequency ?? 0}</td>
                        </tr>
                    `).join("")
                    );

                })
                .fail(() => {
                    $("#readingBody").html("<tr><td colspan='6'>Failed to load readings.</td></tr>");
                });
        }

        $("#year, #month").on("change", () => {
            const serial = $("#readingModal").data("serialNo");
            if (serial) loadReadings(serial);
        });



        /* ---------------- Generate Bill ---------------- */
        $("#generateBillBtn").click(() => {

            const meter = $("#readingModal").data("serialNo");
            const year = $("#year").val();
            const month = $("#month").val();

            const fromDate = `${year}-${month}-01`;
            const toDate = `${year}-${month}-30`;

            $.ajax({
                url: `${apiBilling}/calculate?meterId=${meter}&fromDate=${fromDate}&toDate=${toDate}`,
                method: "POST"
            })
            .done(bill => {

                $('#modalMeter').text(bill.meterSerialNo ?? '-');
                $('#modalUnits').text(bill.totalUnits ?? 0);
                $('#modalBaseRate').text(bill.baseRate ?? 0);
                $('#modalTaxRate').text(bill.taxRate ?? 0);
                $('#modalAmount').text(bill.billAmount ?? 0);
                $('#modalSlabs').text(bill.slabsApplied ?? '-');

                $('#billQR').attr('src',
                    `https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=PAYMENT-${bill.billId ?? '0'}`);

                new bootstrap.Modal(document.getElementById("paymentModal")).show();

                loadBills();
            })
            .fail(xhr => {
                alert("Failed to generate bill: " + (xhr.responseJSON?.message ?? "Unknown error"));
            });

        });



        /* ---------------- Load Bills List ---------------- */
        function loadBills() {
            $.get(`${apiBilling}/consumer/${consumerId}`)
                .done(data => {

                    if (!data || !data.length) {
                        $("#billBody").html("<tr><td colspan='5'>No bills found.</td></tr>");
                        return;
                    }

                    $("#billBody").html(
                        data.map(b => `
                        <tr>
                            <td>${b.billId}</td>
                            <td>${b.meterSerialNo}</td>
                            <td>${b.totalAmount ?? 0}</td>
                            <td>${new Date(b.billGeneratedAt).toLocaleDateString()}</td>
                            <td>
                                <button class="btn btn-sm btn-success payBtn"
                                        data-bill='${JSON.stringify(b)}'>
                                    Pay
                                </button>
                            </td>
                        </tr>
                    `).join("")
                    );

                })
                .fail(() => {
                    $("#billBody").html("<tr><td colspan='5'>Failed to load bills.</td></tr>");
                });
        }

        loadBills();



        /* ---------------- Payment ---------------- */
        $(document).on("click", "#payBtn", () => {
            alert("Payment processed successfully!");
            $("#paymentModal").modal("hide");
        });

        $(document).on("click", ".payBtn", function () {

            const bill = $(this).data("bill");

            $('#modalMeter').text(bill.meterSerialNo);
            $('#modalUnits').text(bill.totalUnits ?? 0);
            $('#modalBaseRate').text(bill.baseRate ?? 0);
            $('#modalTaxRate').text(bill.taxRate ?? 0);
            $('#modalAmount').text(bill.totalAmount ?? bill.billAmount ?? 0);
            $('#modalSlabs').text(bill.slabsApplied ?? '-');

            $('#billQR').attr('src',
                `https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=PAYMENT-${bill.billId ?? '0'}`);

            new bootstrap.Modal(document.getElementById("paymentModal")).show();

        });

    });

</script>
