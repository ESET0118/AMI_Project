@{
    ViewBag.Title = "User Dashboard";
    Layout = "~/Views/Shared/_NavUser.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="dashboard-container min-vh-100 py-4">

    <!-- Hero Section -->
    <section class="hero-section text-center text-light py-5 mb-5">
        <div class="container">
            <h1 class="fw-bold mb-3">👋 Welcome, <span id="userName">User</span></h1>
            <p class="lead mb-0">Here’s your personalized energy dashboard</p>
        </div>
    </section>

    <!-- Main Content -->
    <div class="container pb-5">
        <div class="text-center mb-5">
            <h2 class="fw-bold text-dark">Your Energy Overview</h2>
            <p class="text-muted">Get insights into your daily, weekly and monthly usage</p>
        </div>

        <!-- Summary Cards -->
        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="card shadow-lg border-0 rounded-4 card-energy text-center p-4">
                    <h5 class="fw-bold text-dark">Today's Usage</h5>
                    <h2 class="fw-bold text-primary">12.4 kWh</h2>
                    <p class="text-muted small">Energy consumed today</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-lg border-0 rounded-4 card-energy text-center p-4">
                    <h5 class="fw-bold text-dark">Weekly Usage</h5>
                    <h2 class="fw-bold text-success">78 kWh</h2>
                    <p class="text-muted small">Total this week</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-lg border-0 rounded-4 card-energy text-center p-4">
                    <h5 class="fw-bold text-dark">Alerts</h5>
                    <h2 class="fw-bold text-danger">1</h2>
                    <p class="text-muted small">High usage detected</p>
                </div>
            </div>
        </div>

        <!-- Chart Placeholder -->
        <div class="card shadow-lg border-0 rounded-4 p-4">
            <h5 class="fw-bold text-dark mb-3">Daily Usage Trend</h5>
            <div style="height: 400px;">
                <canvas id="userUsageChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Styles -->
<style>
    body {
        font-family: "Inter", system-ui, sans-serif;
        background: #f8f9fa;
    }

    .hero-section {
        background: linear-gradient(135deg, rgba(0,179,216,0.9), rgba(0,208,132,0.9)), url('https://images.unsplash.com/photo-1581091215367-59ab6a143df2?auto=format&fit=crop&w=1200&q=80') center/cover no-repeat;
        border-radius: 0 0 40px 40px;
        box-shadow: 0 8px 20px rgba(0, 179, 216, 0.3);
    }

    .card-energy:hover {
        transform: translateY(-5px);
        box-shadow: 0 6px 18px rgba(0, 179, 216, 0.25);
    }
</style>

<!-- Scripts -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(document).ready(function () {
        const token = localStorage.getItem("jwtToken");
        const username = localStorage.getItem("UserName");

        if (!token) {
            window.location.href = "/Account/Login";
        }
        else {
            $("#userName").text(username ?? "User");
        }
    });

    $("#logoutBtn").click(function () {
        localStorage.removeItem("jwtToken");
        window.location.href = "/Account/Login";
    });
</script>

<script>
    const ctx = document.getElementById('userUsageChart').getContext('2d');

    const userUsageChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
            datasets: [
                {
                    label: 'Your Usage (kWh)',
                    data: [11, 13, 15, 12, 18, 20, 17],
                    borderColor: 'rgba(0, 123, 255, 1)',
                    backgroundColor: 'rgba(0, 123, 255, 0.25)',
                    tension: 0.4,
                    fill: true,
                    pointRadius: 5,
                    pointHoverRadius: 7
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'top' },
            },
            scales: {
                y: { beginAtZero: true },
                x: {}
            }
        }
    });
</script>
