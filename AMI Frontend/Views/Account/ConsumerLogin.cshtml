@{
    ViewBag.Title = "Consumer Login";
    Layout = null;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container d-flex align-items-center justify-content-center min-vh-100">
    <div class="login-card row shadow-lg rounded-4 overflow-hidden w-100" style="max-width: 900px;">
        <!-- Left Panel -->
        <div class="col-md-6 left-panel d-flex flex-column justify-content-center p-5 text-white">
            <h1 class="fw-bold mb-3">Welcome ⚡</h1>
            <p class="lead">Access your consumer dashboard quickly by entering your name below.</p>
        </div>

        <!-- Right Panel -->
        <div class="col-md-6 right-panel p-5">
            <h3 class="text-center mb-4 fw-semibold">Consumer Login</h3>

            <form id="consumerLoginForm">
                <div class="mb-3">
                    <label class="form-label">Consumer Name</label>
                    <input type="text" id="consumerName" class="form-control" placeholder="Enter your name" required>
                </div>
                <button type="submit" class="btn btn-energy w-100 py-2 fw-semibold">Login</button>
            </form>

            <div class="text-center mt-3">
                <p>
                    Back to system login?
                    <a href="/Account/Login" class="text-decoration-none fw-semibold text-accent">Click here</a>
                </p>
            </div>

            <p class="error-message text-center mt-2" id="errorMsg"></p>
        </div>
    </div>
</div>

<style>
    body {
        font-family: "Inter", system-ui, sans-serif;
        background: linear-gradient(135deg,#00b3d8 0%,#00d084 100%);
        transition: all 0.4s ease-in-out;
    }

    .left-panel {
        background: linear-gradient(160deg,#00b3d8,#00d084);
        color: #fff;
    }

    .right-panel {
        background-color: #fff;
        color: #222;
    }

    .form-control {
        background-color: #fff;
        border: 1px solid #ddd;
    }

    .btn-energy {
        background: linear-gradient(90deg,#00b3d8,#00d084);
        border: none;
        color: white;
        font-size: 1.05rem;
    }

    .text-accent {
        color: #00b3d8;
    }

    .error-message {
        color: #dc3545;
        font-size: 0.95rem;
    }

    @@media (max-width: 768px) {
        .left-panel

    {
        display: none;
    }

    .right-panel {
        padding: 2rem 1.5rem;
    }

    }
</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function() {
        $("#consumerLoginForm").submit(function(e){
            e.preventDefault();

            const name = $("#consumerName").val().trim();
            if (!name) {
                $("#errorMsg").text("Please enter your name.");
                return;
            }

            console.log("Attempting consumer login:", name);

            $.ajax({
                url: `https://localhost:7199/api/Consumer/consumer/${encodeURIComponent(name)}`,
                method: "GET",
                success: function(data) {
                    if (!data || !data.consumerId) {
                        $("#errorMsg").text("Invalid consumer data received.");
                        console.error("Invalid data from API:", data);
                    }

                    try {
                        localStorage.setItem("consumerData", JSON.stringify(data));
                        console.log("consumerData saved:", localStorage.getItem("consumerData"));

                        // Use replace to avoid back button issues
                        window.location.replace("/Dashboard/Consumer");
                    } catch (err) {
                        console.error("Failed to save consumerData:", err);
                        $("#errorMsg").text("Unable to store login info locally.");
                    }
                },
                error: function(xhr, status, error) {
                    let msg = "Consumer not found";
                    try { msg = xhr.responseJSON?.message || msg; } catch(e){ }
                    $("#errorMsg").text(msg);
                    console.error("Login error:", status, error);
                }
            });

            return false;
        });
    });
</script>

